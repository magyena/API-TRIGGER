# Vercel Environment Variables Configuration
# Set these in your Vercel Project Settings -> Environment Variables

# Database URL (MySQL / PlanetScale / Aiven / Railway / VPS MySQL)
DATABASE_URL="mysql://username:password@your-mysql-host:3306/hijafera_db"

# JWT Secret for Admin Session Security
JWT_SECRET="hijafera-super-secret-jwt-key-2026-secure"

# Base Domain URL (Your Vercel Deployment URL or Custom Domain)
NEXT_PUBLIC_APP_URL="https://trigger.domain.com"
